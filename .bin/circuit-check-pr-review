#!/usr/bin/env sh
set -eu

fail() {
	printf '%s\n' "$1" >&2
	exit 1
}

[ -n "${CIRCUIT_SESSION_ID}" ] || fail "CIRCUIT_SESSION_ID is required"
config=.tmp/circuit/$CIRCUIT_SESSION_ID/pr-watch.env

[ -f "$config" ] || fail "missing pr-watch evidence file: $config"

read_config_key() {
	awk -v key="$1" '
		BEGIN { FS = "=" }
		$1 == key { value = substr($0, index($0, "=") + 1) }
		END { print value }
	' "$config"
}

pr=$(read_config_key PR_NUMBER)
repo=$(read_config_key REPO)

[ -n "$pr" ] || fail "PR_NUMBER is required in $config"
[ -n "$repo" ] || fail "REPO is required in $config"

set +e
open_threads=$(gh api "repos/$repo/pulls/$pr/reviews" --jq '
  [.[] | select(.state != "APPROVED" and .state != "DISMISSED")] | length
' 2>&1)
set -e

if [ "$open_threads" = "0" ]; then
	printf 'review clean: no open findings\n'
	exit 0
fi

printf 'review has %s open finding(s)\n' "$open_threads" >&2
exit 1
