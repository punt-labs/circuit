# Build artifacts
/circuit
dist/
coverage.out
coverage-*.out
.pi/coverage/
*.prob
*.fuzz
*.fuzz.json
*.report.json
*.audit.json
.pi/node_modules/

# Scratch/temp directory
.tmp/

# direnv
.direnv/

# Local environment overrides
.envrc.local

# Beads runtime artifacts are ignored by .beads/.gitignore

# IDE
.idea/

# Python bytecode cache
__pycache__/
*.py[cod]

# Ethos runtime state (per-session activity logs, locks) — churns constantly, never committed
.punt-labs/local/

# ethos: machine-local files (.local.*) — may hold secrets, never track
.punt-labs/**/*.local.*

# ethos runtime (never track) — DES-058 live zone + mission locks
.punt-labs/**/local/**
.punt-labs/ethos/missions/**/*.lock

# ethos runtime: per-session rosters and mission activity (never track)
.punt-labs/ethos/sessions/
.punt-labs/ethos/missions/
.punt-labs/ethos/missions.jsonl
.punt-labs/ethos/missions.jsonl.lock
